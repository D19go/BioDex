<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Alias usado pelo manifesto: o tema real é escolhido em runtime (ThemeController). -->
  <style name="AppTheme" parent="AppThemeLight" />

  <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#2E7D32</item>
    <item name="android:navigationBarColor">#000000</item>
    <item name="android:statusBarColor">#1B5E20</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:buttonStyle">@style/HudButtonLight</item>
  </style>

  <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#81C784</item>
    <item name="android:navigationBarColor">#000000</item>
    <item name="android:statusBarColor">#000000</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:buttonStyle">@style/HudButtonDark</item>
  </style>

  <!-- Botões do app: cor do tema (verde sobre fundo escuro, verde sobre fundo claro). -->
  <style name="HudButtonDark" parent="android:style/Widget.Material.Button">
    <item name="android:background">@drawable/hud_button_dark</item>
    <item name="android:textColor">#FF83D957</item>
  </style>

  <style name="HudButtonLight" parent="android:style/Widget.Material.Light.Button">
    <item name="android:background">@drawable/hud_button_light</item>
    <item name="android:textColor">#FF1E7A0F</item>
  </style>
</resources>
